{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{unet_name}}", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "{{clip_name}}", "type": "wan", "device": "default"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae_name}}"}},
  "4": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["1", 0], "shift": 8.0}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["2", 0]}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative}}", "clip": ["2", 0]}},
  "12": {"class_type": "LoadImage", "inputs": {"image": "{{image}}"}},
  "13": {"class_type": "CLIPVisionLoader", "inputs": {"clip_name": "{{clip_vision_name}}"}},
  "14": {"class_type": "CLIPVisionEncode", "inputs": {"clip_vision": ["13", 0], "image": ["12", 0], "crop": "none"}},
  "7": {"class_type": "WanImageToVideo", "inputs": {"positive": ["5", 0], "negative": ["6", 0], "vae": ["3", 0], "clip_vision_output": ["14", 0], "start_image": ["12", 0], "width": "{{width}}", "height": "{{height}}", "length": "{{length}}", "batch_size": 1}},
  "8": {"class_type": "KSampler", "inputs": {"model": ["4", 0], "seed": "{{seed}}", "steps": 25, "cfg": 6.0, "sampler_name": "uni_pc", "scheduler": "simple", "positive": ["7", 0], "negative": ["7", 1], "latent_image": ["7", 2], "denoise": 1.0}},
  "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
  "10": {"class_type": "CreateVideo", "inputs": {"images": ["9", 0], "fps": "{{fps}}"}},
  "11": {"class_type": "SaveVideo", "inputs": {"video": ["10", 0], "filename_prefix": "{{filename_prefix}}", "format": "mp4", "codec": "h264"}}
}
